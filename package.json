{
  "name": "study-coach",
  "productName": "阿咲",
  "version": "1.0.0",
  "description": "本地优先的个人管家",
  "private": true,
  "type": "commonjs",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dev:web": "vite --config vite.web.config.mts",
    "build:web": "vite build --config vite.web.config.mts",
    "preview:web": "vite preview --config vite.web.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test --config e2e/playwright.config.ts",
    "test:e2e:debug": "npm run build && playwright test --config e2e/playwright.config.ts --debug",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --mac",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@ai-sdk/openai-compatible": "^3.0.82",
    "ai": "^7.0.159",
    "chokidar": "^6.0.0",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "xiaolai"
}
